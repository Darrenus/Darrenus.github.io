{
  "name": "rong-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RONG Agent - 贺融的个人 AI 助手，Agent 运行在访问者的浏览器中。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "corpus": "tsx scripts/build-corpus.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx --tsconfig tsconfig.app.json scripts/markdown.test.mjs && tsx scripts/content.test.ts && tsx scripts/routes.test.ts && tsx scripts/query-corpus.ts --self-test"
  },
  "dependencies": {
    "minisearch": "^7.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.0"
  }
}
