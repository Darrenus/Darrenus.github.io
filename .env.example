# Public site configuration. This URL is safe to expose; it contains no API key.
# For local proxy testing use: http://localhost:3000
VITE_AGENT_PROXY_URL=

# Optional model overrides. Keep these in sync with proxy/DEEPSEEK_MODELS.
# The defaults remain deepseek-v4-flash for compatibility with the current build.
VITE_AGENT_MODEL=deepseek-v4-flash
VITE_AGENT_FAST_MODEL=deepseek-v4-flash
